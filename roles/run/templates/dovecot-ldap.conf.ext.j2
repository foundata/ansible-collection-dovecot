# {{ ansible_managed }}

## Dovecot LDAP backend configuration
##
## This file uses Dovecot's alternate parser: no "!include" directives,
## no "$variable" references, raw "key = value" lines only. The file is
## referenced from a "passdb { driver = ldap; args = <this-path> }" (and
## optionally a "userdb { driver = ldap; args = <sibling-path> }") block in
## dovecot.conf.

{% for key, value in (__run_dovecot_external_files_ldap_settings | default({})).items() -%}
{% if value is boolean -%}
{{ key }} = {{ 'yes' if value else 'no' }}
{% elif value is iterable and value is not string -%}
{{ key }} = {{ value | map('string') | join(' ') }}
{% else -%}
{{ key }} = {{ value }}
{% endif -%}
{% endfor -%}
