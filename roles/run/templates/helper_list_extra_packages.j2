{# Return the list of additional distribution packages to install on top of
   `__run_dovecot_packages_install`, derived from the user's Dovecot settings.

   Inputs scanned:
     - run_dovecot_settings['protocols']                  → top-level protocols
     - run_dovecot_settings['mail_plugins']               → top-level plugins
     - run_dovecot_settings['protocol <name>']['mail_plugins']  → per-protocol plugins
     - run_dovecot_passdbs[*]['driver'] / run_dovecot_userdbs[*]['driver'] → auth backends

   Each protocol token is looked up in __run_dovecot_packages_protocols_map.
   Each plugin token is looked up in __run_dovecot_packages_plugins_map.
   Each passdb/userdb driver is looked up in __run_dovecot_packages_authdb_map.

   Unknown protocol and mail_plugin tokens are rejected up front by Ansible-side
   assertions (see tasks/setup/install/default.yml), so anything reaching this
   template is already a known key. Unknown passdb/userdb drivers are simply
   skipped here (the auth-driver set is open-ended and intentionally lenient).

   Tokens beginning with `$` (e.g. `$mail_plugins`) are skipped as those are
   Dovecot setting references, not literal plugin/protocol names.
#}
{% set protocols_raw = run_dovecot_settings['protocols'] | ansible.builtin.default([]) -%}
{% set plugin_strings = [] -%}
{% if run_dovecot_settings['mail_plugins'] is ansible.builtin.defined -%}
{%   set _ = plugin_strings.append(run_dovecot_settings['mail_plugins']) -%}
{% endif -%}
{% for key, value in run_dovecot_settings.items() -%}
{%   if (key is ansible.builtin.string) and (key.startswith('protocol ')) and (value is ansible.builtin.mapping) and (value['mail_plugins'] is ansible.builtin.defined) -%}
{%     set _ = plugin_strings.append(value['mail_plugins']) -%}
{%   endif -%}
{% endfor -%}

{% set protocols_list = [] -%}
{% if protocols_raw is ansible.builtin.iterable and protocols_raw is not ansible.builtin.string -%}
{%   for p in protocols_raw %}{% set _ = protocols_list.append(p | ansible.builtin.string | ansible.builtin.trim) %}{% endfor -%}
{% else -%}
{%   for p in (protocols_raw | ansible.builtin.string | ansible.builtin.split) %}{% set _ = protocols_list.append(p | ansible.builtin.trim) %}{% endfor -%}
{% endif -%}

{% set plugin_list = [] -%}
{% for s in plugin_strings -%}
{%   if s is ansible.builtin.iterable and s is not ansible.builtin.string -%}
{%     for p in s %}{% set _ = plugin_list.append(p | ansible.builtin.string | ansible.builtin.trim) %}{% endfor -%}
{%   else -%}
{%     for p in (s | ansible.builtin.string | ansible.builtin.split) %}{% set _ = plugin_list.append(p | ansible.builtin.trim) %}{% endfor -%}
{%   endif -%}
{% endfor -%}

{% set authdb_drivers = [] -%}
{% for db in ((run_dovecot_passdbs | ansible.builtin.default([])) + (run_dovecot_userdbs | ansible.builtin.default([]))) -%}
{%   if (db is ansible.builtin.mapping) and (db['driver'] is ansible.builtin.defined) -%}
{%     set _ = authdb_drivers.append(db['driver'] | ansible.builtin.string | ansible.builtin.trim) -%}
{%   endif -%}
{% endfor -%}

{% set extras = [] -%}
{% for p in (protocols_list | ansible.builtin.reject('ansible.builtin.match', '^\s*$') | ansible.builtin.reject('ansible.builtin.match', '^\$') | ansible.builtin.unique | ansible.builtin.list) -%}
{%   if p in __run_dovecot_packages_protocols_map -%}
{%     for pkg in __run_dovecot_packages_protocols_map[p] %}{% set _ = extras.append(pkg) %}{% endfor -%}
{%   endif -%}
{% endfor -%}
{% for p in (plugin_list | ansible.builtin.reject('ansible.builtin.match', '^\s*$') | ansible.builtin.reject('ansible.builtin.match', '^\$') | ansible.builtin.unique | ansible.builtin.list) -%}
{%   if p in __run_dovecot_packages_plugins_map -%}
{%     for pkg in __run_dovecot_packages_plugins_map[p] %}{% set _ = extras.append(pkg) %}{% endfor -%}
{%   endif -%}
{% endfor -%}
{% for d in (authdb_drivers | ansible.builtin.reject('ansible.builtin.match', '^\s*$') | ansible.builtin.unique | ansible.builtin.list) -%}
{%   if d in __run_dovecot_packages_authdb_map -%}
{%     for pkg in __run_dovecot_packages_authdb_map[d] %}{% set _ = extras.append(pkg) %}{% endfor -%}
{%   endif -%}
{% endfor -%}

{{ extras | ansible.builtin.unique | ansible.builtin.sort | ansible.builtin.list }}
