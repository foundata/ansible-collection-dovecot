{# Return the deduplicated list of mail_plugin tokens declared in
   run_dovecot_settings['mail_plugins'] (top level) and in every
   run_dovecot_settings['protocol <name>']['mail_plugins'], normalising
   scalar/list/dict (block-form) input and skipping `$variable` references and
   empty entries. Consumed by the Ansible-side assertion that catches unknown
   plugin names (see tasks/setup/install/default.yml). #}
{% set strings = [] -%}
{% if run_dovecot_settings['mail_plugins'] is defined -%}
{%   set _ = strings.append(run_dovecot_settings['mail_plugins']) -%}
{% endif -%}
{% for key, value in run_dovecot_settings.items() -%}
{%   if (key is string) and (key.startswith('protocol ')) and (value is mapping) and (value['mail_plugins'] is defined) -%}
{%     set _ = strings.append(value['mail_plugins']) -%}
{%   endif -%}
{% endfor -%}
{% set out = [] -%}
{% for s in strings -%}
{%   if s is iterable and s is not string -%}
{%     for p in s %}{% set _ = out.append(p | string | trim) %}{% endfor -%}
{%   else -%}
{%     for p in (s | string | split) %}{% set _ = out.append(p | trim) %}{% endfor -%}
{%   endif -%}
{% endfor -%}
{{ out | reject('match', '^\s*$') | reject('match', '^\$') | unique | sort | list }}
