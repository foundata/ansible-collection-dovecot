{# Return the deduplicated list of protocol tokens declared in
   `run_dovecot_settings['protocols']`, normalising scalar vs. list input and
   skipping `$variable` references and empty entries. Consumed by the
   Ansible-side assertion that catches unknown protocol names. #}
{% set raw = run_dovecot_settings['protocols'] | ansible.builtin.default([]) -%}
{% set out = [] -%}
{% if raw is ansible.builtin.iterable and raw is not ansible.builtin.string -%}
{%   for p in raw %}{% set _ = out.append(p | ansible.builtin.string | ansible.builtin.trim) %}{% endfor -%}
{% else -%}
{%   for p in (raw | ansible.builtin.string | ansible.builtin.split) %}{% set _ = out.append(p | ansible.builtin.trim) %}{% endfor -%}
{% endif -%}
{{ out | ansible.builtin.reject('ansible.builtin.match', '^\s*$') | ansible.builtin.reject('ansible.builtin.match', '^\$') | ansible.builtin.unique | ansible.builtin.sort | ansible.builtin.list }}
