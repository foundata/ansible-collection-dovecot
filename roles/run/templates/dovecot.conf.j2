{% from '_dovecot_macros.j2' import render_settings, render_dbblocks -%}
# {{ ansible managed }}

# Dovecot configuration
#
# Do not edit this file directly. Place site-local overrides into
# /etc/dovecot/local.conf instead — it is `!include_try`'d at the end of
# this file so it takes precedence over everything above without surviving
# a re-run of the role.
#
# Distribution-shipped /etc/dovecot/conf.d/*.conf files are intentionally
# NOT included (no `!include conf.d/*.conf` is emitted). They remain on
# disk but dormant, see the {{ __run_dovecot_confd_tombstone_file_path | ansible.builtin.basename }}
# in that directory.

{# Dovecot 2.4 REQUIRES dovecot_config_version as the first non-comment line.
   Emit it (and dovecot_storage_version, if present) up front, regardless of
   where they appear in the user's run_dovecot_settings dict.
#}
{% if run_dovecot_settings['dovecot_config_version'] is defined -%}
dovecot_config_version = {{ run_dovecot_settings['dovecot_config_version'] }}
{% endif -%}
{% if run_dovecot_settings['dovecot_storage_version'] is defined -%}
dovecot_storage_version = {{ run_dovecot_settings['dovecot_storage_version'] }}
{% endif %}

{{ render_settings(run_dovecot_settings) -}}

{% if run_dovecot_passdbs | length > 0 %}
{{ render_dbblocks(run_dovecot_passdbs, 'passdb') -}}
{% endif -%}
{% if run_dovecot_userdbs | length > 0 %}
{{ render_dbblocks(run_dovecot_userdbs, 'userdb') -}}
{% endif %}

{% if run_dovecot_settings_extra_content | length > 0 -%}
##
## Raw verbatim content from `run_dovecot_settings_extra_content`:
##
{{ run_dovecot_settings_extra_content }}
{% endif -%}

## Site-local overrides (not managed by Ansible).
!include_try local.conf
