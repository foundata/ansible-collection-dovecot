# {{ tpl_managed }}

# Dovecot master-users passwd-file
#
# Format: <username>:<{SCHEME}hash>
#
# Referenced from a
# "passdb { driver = passwd-file; args = <this-path>; master = yes }"
# block in dovecot.conf. Master users authenticate as
# "<real-user>*<master-username>" per the Dovecot master user convention.

{% for entry in (tpl_external_files_master_users_entries | ansible.builtin.default([])) -%}
{{ entry['username'] }}:{{ entry['password_hash'] }}
{% endfor -%}
